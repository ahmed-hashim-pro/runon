# The sdist shipped tests/test_*.py but not conftest.py or pty_driver.py, so
# `pytest` from a released tarball failed to collect five modules. Distro
# packagers build from the sdist and run the suite; that has to work.
include MANIFEST.in
recursive-include tests *.py
recursive-include share *
recursive-include examples *
include docs/ACCEPTANCE.md
